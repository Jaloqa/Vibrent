{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [ { "Name": "Console" } ],
    "Enrich": [ "FromLogContext" ]
  },
  "Jwt": {
    "Issuer": "vibrent-api",
    "Audience": "vibrent-web",
    "ExpiryMinutes": 60
  },
  "AllowedHosts": "*"
}
