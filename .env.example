# Copy to .env and fill in. .env is git-ignored.

POSTGRES_DB=vibrent
POSTGRES_USER=vibrent
POSTGRES_PASSWORD=vibrent
# Host port for the database; 5433 avoids clashing with a locally installed PostgreSQL
DB_PORT=5433

API_PORT=8080
ASPNETCORE_ENVIRONMENT=Development
# At least 32 characters; use a random value outside local development
JWT_SIGNING_KEY=change-me-local-dev-signing-key-32-chars-min
